# --- Production: Groq (free key from https://console.groq.com/keys) -------------
GROQ_API_KEY=gsk_your_key_here

# Any open-weight model Groq serves. Defaults to openai/gpt-oss-120b (Apache-2.0).
# Alternatives: qwen/qwen3.8-27b, openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b

# Point the app at any other OpenAI-compatible endpoint instead (optional):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Evals only: FreeLLMAPI (local router over many free tiers) -----------------
# Used by `python tests/evals.py --provider freellmapi`. The unified key is on the
# router's Keys page (http://localhost:3001). Not for production: the project says
# so itself, and its routing can change the answering model between requests.
# FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=      # pin one model; see --list-models. Never "auto" for ablations.
# FREELLMAPI_URL=http://localhost:3001/v1

# --- App behaviour -----------------------------------------------------------------
# Privacy mode. false = send column names and types only; no data values leave
# the machine. Measured cost on the sample data: none (docs/evals.md).
# SEND_SAMPLES=true

# Business definitions the model must use (e.g. "revenue is net of refunds").
# METRICS_PATH=config/metrics.toml

# One JSONL line per question: SQL, status, tokens, latency, serving model. Never result rows.
# TRACE_PATH=logs/queries.jsonl
